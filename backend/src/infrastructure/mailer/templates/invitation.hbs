{{!-- Invitation email template --}}
<div dir="{{dir}}" style="direction:{{dir}};text-align:{{#ifCond dir '===' 'rtl'}}right{{else}}left{{/ifCond}};">
  <h1 style="margin:0 0 8px;font-size:26px;font-weight:700;color:#0f172a;line-height:1.3;">
    {{title}}
  </h1>
  <p style="margin:0 0 24px;font-size:15px;color:#64748b;line-height:1.7;">
    {{intro}}
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
      <td style="padding:18px 20px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;">
        <p style="margin:0 0 10px;font-size:13px;color:#64748b;">{{recipientLabel}}</p>
        <p style="margin:0 0 14px;font-size:14px;color:#334155;">{{contactValue}}</p>
        <p style="margin:0 0 10px;font-size:13px;color:#64748b;">{{invitedByLabel}}</p>
        <p style="margin:0 0 14px;font-size:15px;color:#0f172a;font-weight:700;">{{inviterName}}</p>
        <p style="margin:0 0 10px;font-size:13px;color:#64748b;">{{inviterRoleLabel}}</p>
        <p style="margin:0 0 14px;font-size:14px;color:#334155;">{{inviterRoleLabelValue}}</p>
        <p style="margin:0 0 10px;font-size:13px;color:#64748b;">{{invitedAsLabel}}</p>
        <p style="margin:0;font-size:14px;color:#0891b2;font-weight:700;">{{invitedRoleLabelValue}}</p>
      </td>
    </tr>
  </table>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
      <td style="padding:18px 20px;background:#f0f9ff;border-radius:12px;border-left:4px solid #0891b2;">
        <p style="margin:0 0 8px;font-size:15px;color:#0f172a;font-weight:700;">{{onboardingTitle}}</p>
        <p style="margin:0 0 10px;font-size:14px;color:#334155;line-height:1.7;">{{onboardingDescription}}</p>
        <p style="margin:0 0 8px;font-size:13px;color:#0f172a;font-weight:700;">{{onboardingStepsTitle}}</p>
        <ol style="margin:0 0 12px;padding-{{#ifCond dir '===' 'rtl'}}right{{else}}left{{/ifCond}}:20px;color:#334155;font-size:13px;line-height:1.7;">
          {{#each onboardingSteps}}
            <li style="margin:0 0 6px;">{{this}}</li>
          {{/each}}
        </ol>
        <p style="margin:0;font-size:13px;color:#0f766e;line-height:1.6;">{{expirationText}}</p>
      </td>
    </tr>
  </table>

  <p style="margin:0 0 12px;font-size:15px;color:#0f172a;font-weight:700;">{{accessTitle}}</p>
  <ul style="margin:0 0 24px;padding-{{#ifCond dir '===' 'rtl'}}right{{else}}left{{/ifCond}}:20px;color:#475569;font-size:14px;line-height:1.8;">
    {{#each accessItems}}
      <li style="margin:0 0 8px;">{{this}}</li>
    {{/each}}
  </ul>

  {{#if personalMessage}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
      <td style="padding:16px 20px;background:#fff7ed;border-radius:12px;border-left:4px solid #f97316;">
        <p style="margin:0 0 8px;font-size:14px;color:#9a3412;font-weight:700;">{{customMessageLabel}}</p>
        <p style="margin:0;font-size:14px;color:#7c2d12;line-height:1.7;font-style:italic;">
          "{{personalMessage}}"
        </p>
      </td>
    </tr>
  </table>
  {{/if}}

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 28px;">
    <tr>
      <td align="center">
        {{> button url=signupUrl label=actionLabel}}
      </td>
    </tr>
  </table>

  <p style="margin:0 0 24px;font-size:13px;color:#64748b;line-height:1.7;">
    {{actionHint}}
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    <tr>
      <td style="padding:18px 20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;">
        <p style="margin:0 0 10px;font-size:14px;color:#0f172a;font-weight:700;">{{securityTitle}}</p>
        <ul style="margin:0;padding-{{#ifCond dir '===' 'rtl'}}right{{else}}left{{/ifCond}}:20px;color:#475569;font-size:13px;line-height:1.7;">
          {{#each securityItems}}
            <li style="margin:0 0 6px;">{{this}}</li>
          {{/each}}
        </ul>
      </td>
    </tr>
  </table>

  {{> divider}}

  <p style="margin:0 0 6px;font-size:12px;color:#94a3b8;line-height:1.6;">
    {{fallbackText}}
  </p>
  <p style="margin:0;font-size:12px;color:#94a3b8;line-height:1.6;word-break:break-all;">
    <a href="{{signupUrl}}" style="color:#0891b2;word-break:break-all;">{{signupUrl}}</a>
  </p>
</div>
